rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 1. REGRAS PRIVADAS: Escopo de cada professor
    // O uso de {document=**} garante que todas as subcoleções (turmas, alunos, etc) 
    // sigam a mesma regra do pai: só o dono acessa.
    match /professores/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. REGRAS PÚBLICAS: Banco de Questões da Comunidade
    match /comunidade_questoes/{questaoId} {
      // Leitura pública das questões compartilhadas
      allow read: if true;
      
      // Criação: Exige login e valida se o uid_autor coincide com o usuário logado
      allow create: if request.auth != null && request.resource.data.uid_autor == request.auth.uid;
      
      // Exclusão: Apenas o criador original pode remover
      allow delete: if request.auth != null && resource.data.uid_autor == request.auth.uid;
      
      // Bloqueia edições (Update)
      allow update: if false;
    }

    // 3. REGRAS PÚBLICAS: Banco de Materiais da Comunidade
    match /comunidade_materiais/{materialId} {
      // Leitura pública de materiais pedagógicos compartilhados
      allow read: if true;
      
      // Criação: Exige login e valida se o uid_autor coincide com o usuário logado
      allow create: if request.auth != null && request.resource.data.uid_autor == request.auth.uid;
      
      // Exclusão: Apenas o autor original pode remover da comunidade
      allow delete: if request.auth != null && resource.data.uid_autor == request.auth.uid;
      
      // Bloqueia edições (Update)
      allow update: if false;
    }
    
    // 4. REGRAS DE SISTEMA (Chaves de API)
    match /system_config/{document=**} {
      allow read: if true;
      allow write: if false; 
    }
    
    // 5. SESSÕES DE QUIZ AO VIVO (Público / Alunos com PIN)
    match /quiz_sessions/{pin} {
      allow read: if true;
      allow create, update: if request.auth != null || (request.resource.data.keys().hasAny(['respostas', 'alunos', 'status', 'participantes']));
      allow delete: if request.auth != null;
    }
  }
}
